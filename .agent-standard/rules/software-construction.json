{"rules":[{"id":"SC-001","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Satisfy the authorized contract and preserve correctness before optimizing style, abstraction, or elegance.","applies_to":{"profiles":["general","code-change","bug-fix","refactor","architecture-change"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"LOCKED","sources":["CodeComplete:Construction","CleanCode:Ch1","Ousterhout:Ch3"],"kernel":true},{"id":"SC-002","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Prefer the simplest design that meets the authorized requirements; do not introduce complexity, generality, or layers that are not justified by present need.","applies_to":{"profiles":["general","code-change","bug-fix","refactor","architecture-change"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"LOCKED","sources":["CodeComplete:Complexity","Ousterhout:Ch1","Ousterhout:Ch3"],"kernel":true},{"id":"SC-003","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Keep modules cohesive and interfaces narrow; a module should hide a secret and expose a stable, intentional contract.","applies_to":{"profiles":["code-change","bug-fix","refactor","architecture-change"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CodeComplete:Modules","Ousterhout:Ch4"]},{"id":"SC-004","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Name identifiers so that a competent reader can infer role and intent without reconstructing hidden history.","applies_to":{"profiles":["code-change","bug-fix","refactor"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CleanCode:Ch2","CodeComplete:Names"]},{"id":"SC-005","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Handle failure paths explicitly; do not silently swallow errors or leave partial state unspecified.","applies_to":{"profiles":["code-change","bug-fix","refactor"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CodeComplete:ErrorHandling","CleanCode:Ch7"]},{"id":"SC-006","domain":"software-construction","level":"MUST","delivery":"preload","instruction":"Prefer pure data and explicit state transitions over hidden mutable coupling when either approach would work.","applies_to":{"profiles":["code-change","bug-fix","refactor","architecture-change"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CodeComplete:State","Ousterhout:Ch5"]},{"id":"SC-007","domain":"software-construction","level":"SHOULD","delivery":"preload","instruction":"Keep functions short enough that a reader can hold the purpose and structure in working memory; extract when complexity obscures intent.","applies_to":{"profiles":["code-change","bug-fix","refactor"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CleanCode:Ch3","CodeComplete:Routines"]},{"id":"SC-008","domain":"software-construction","level":"SHOULD","delivery":"preload","instruction":"Comments should explain why, constraints, or non-obvious consequences; do not restate the code.","applies_to":{"profiles":["code-change","bug-fix","refactor","architecture-change"],"languages":[]},"verification":{"type":"semantic-review","ref":null},"override_policy":"SPECIALIZABLE","sources":["CleanCode:Ch4","CodeComplete:Comments"]}]}
